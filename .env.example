# Environment variables for the docs-agent project.
# Copy this file to .env and fill in your values.
# One canonical name per credential — no vendor-specific aliases.

# -----------------------------------------------------------------
# EMBEDDING DRIVER
# -----------------------------------------------------------------
# Which embedding backend to use.
# Options:
#   local   - Free, offline, multilingual sentence-transformer (default)
#   openai  - OpenAI Embeddings API (paid)
EMBEDDING_DRIVER=local

# Sentence-Transformers model name (used when EMBEDDING_DRIVER=local).
# Recommended multilingual model for Hungarian/EU documents:
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Vector dimension of the selected model.
# paraphrase-multilingual-MiniLM-L12-v2 → 384
# text-embedding-3-small (OpenAI)        → 1536
EMBEDDING_DIMENSION=384

# API key for the embedding driver (only required when EMBEDDING_DRIVER=openai).
EMBEDDING_API_KEY=

# -----------------------------------------------------------------
# CHUNKING
# -----------------------------------------------------------------
# Approximate word count per text chunk (1 token ≈ 0.75 words).
CHUNK_SIZE=500

# Word overlap between adjacent chunks (preserves context at boundaries).
CHUNK_OVERLAP=50

# Approximate words-per-token ratio, used to estimate whether CHUNK_SIZE
# likely exceeds the active embedding model's token limit. Only used by
# CHUNK_OVERFLOW_STRATEGY=warn. 0.75 is an English-average heuristic;
# morphologically rich languages (e.g. Hungarian) often tokenize worse —
# lower this if needed.
WORDS_PER_TOKEN=0.75

# What to do about chunks that likely/actually exceed the embedding model's
# token limit:
#   warn  (default) — estimate via WORDS_PER_TOKEN, log a warning, but still
#                      truncate silently at embed time.
#   split            — measure each chunk's REAL token count with the active
#                      driver's own tokenizer and re-split any chunk that
#                      overflows, so nothing is ever silently truncated.
#                      Requires a driver with a real tokenizer (currently
#                      only EMBEDDING_DRIVER=local) — falls back to warn
#                      otherwise.
CHUNK_OVERFLOW_STRATEGY=warn

# How to extract text from the PDF before chunking:
#   flat   (default) — join each page's text with a single space. Fast, but
#                       paragraph structure is lost.
#   blocks            — additionally detect paragraph breaks from word
#                        coordinates and preserve them, so
#                        CHUNKING_STRATEGY=langchain can split on them.
#                        Can't detect a break that falls exactly at a page
#                        boundary (coordinates aren't comparable across
#                        pages) — a known, accepted limitation.
PDF_EXTRACTION_MODE=flat

# How to split the (whole-document, page-concatenated) text into chunks:
#   word      (default) — sliding word-count window (CHUNK_SIZE/CHUNK_OVERLAP
#                          above), same behavior as before, just applied to
#                          the whole document instead of per-page — this
#                          alone fixes a paragraph spanning a page break from
#                          being truncated into two chunks.
#   langchain            — paragraph-/sentence-aware splitting
#                          (langchain_text_splitters.RecursiveCharacterTextSplitter):
#                          tries to keep whole paragraphs/sentences together,
#                          only falling back to smaller units when a piece
#                          still doesn't fit the model's token limit.
CHUNKING_STRATEGY=word

# -----------------------------------------------------------------
# LLM (answer generation)  — REQUIRED for query_knowledge_base
# -----------------------------------------------------------------
# Which LLM backend to use for answer generation.
# Options:
#   openrouter  - OpenRouter API; supports free models (default)
#   openai      - OpenAI Chat Completions API (paid subscription required)
LLM_DRIVER=openrouter

# REQUIRED: API key for the active LLM driver.
#   OpenRouter key → https://openrouter.ai/keys
#   OpenAI key     → https://platform.openai.com/api-keys
LLM_API_KEY=your-llm-api-key-here

# Model identifier for the active LLM driver.
# Default: openrouter/free — auto-routes to the best available free model.
# Browse alternatives at https://openrouter.ai/models (filter by ":free").
LLM_MODEL=openrouter/free

# -----------------------------------------------------------------
# RETRIEVAL
# -----------------------------------------------------------------
# Number of chunks to retrieve per query.
RETRIEVAL_TOP_K=4

# Minimum cosine similarity score (0–1). Chunks below this are discarded.
# Lower → more permissive. 0.25 is a sensible default for multilingual docs.
RETRIEVAL_MIN_SCORE=0.25

# -----------------------------------------------------------------
# DATABASE  — REQUIRED
# -----------------------------------------------------------------
# PostgreSQL connection URL with pgvector extension enabled.
#
# Quick start (recommended, no account needed): run `make setup` (or
# `docker compose up -d --wait`), which starts a local Postgres+pgvector
# via docker-compose.yml and creates the "docs_agent" database — the
# value below matches it out of the box.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_agent

# Alternative: any managed Postgres with pgvector works too (e.g. Supabase).
#   Obtain from: Supabase Dashboard → Project Settings → Database → Connection string
#   Use the "Session Mode" pooler URL (port 5432 or 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# -----------------------------------------------------------------
# DEVELOPMENT / TESTING
# -----------------------------------------------------------------
# Path to a PDF used by scripts/extract_text.py and the tests/db/
# add_document() end-to-end test. A small, non-sensitive fixture PDF is
# checked into the repo for this — relative to the project root, so it
# works out of the box for anyone who clones it. If you use your own file
# instead, an absolute path works too, but ⚠️ never commit a real personal
# or client-specific document — keep that one in .env only.
TEST_PDF_PATH=tests/data/test_1.pdf

# tests/db/ (real INSERT/DELETE/TRUNCATE, and migration tests even
# CREATE/DROP TABLE) is enabled by AGENT_ENV=test — `make test` sets this
# automatically. It requires a .env.test file (see .env.test.example) with
# its own DATABASE_URL, loaded on top of this file — never reuses the
# DATABASE_URL above. AGENT_ENV itself must never be set in .env/.env.test
# (see config.py for why); it's always a real shell/CI env var.
