# Environment variables for the docs-agent project.
# Copy this file to .env and fill in your values.
# One canonical name per credential — no vendor-specific aliases.

# -----------------------------------------------------------------
# EMBEDDING DRIVER
# -----------------------------------------------------------------
# Which embedding backend to use.
# Options:
#   local       - Free, offline, multilingual sentence-transformer (default)
#   openai      - OpenAI Embeddings API (paid, direct)
#   openrouter  - Any OpenRouter-hosted embedding model (paid, e.g. Google's
#                 google/gemini-embedding-001) -- same account/key shape as
#                 LLM_DRIVER=openrouter.
#   gemini      - Google's native AI Studio API directly, not via OpenRouter.
#                 Free-tier friendly -- see EMBEDDING_REQUEST_DELAY_SECONDS
#                 below to throttle to your account's actual rate limit.
#   jina        - Jina AI's hosted Embeddings API (paid, direct) -- no
#                 infra/GPU to run, chosen to offload the local model's
#                 CPU-bound cost during bulk ingestion (confirmed live to
#                 dominate ~90%+ of per-document ingest time).
#   vertex      - Google Cloud's Vertex AI text embedding API -- same
#                 no-infra motivation as jina, added after Jina's
#                 free-tier tokens-per-minute cap kept interrupting a
#                 bulk ingest; billed against GCP credit instead. See
#                 VERTEX_PROJECT_ID/VERTEX_LOCATION below.
EMBEDDING_DRIVER=local

# Model name/id for the active driver.
# - EMBEDDING_DRIVER=local: a Sentence-Transformers model name. Recommended
#   multilingual asymmetric retrieval model (384d, 512 tokens):
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# - EMBEDDING_DRIVER=openrouter: an OpenRouter embedding model id, e.g.
#   google/gemini-embedding-001 (3072d native, truncatable via
#   EMBEDDING_DIMENSION -- see below).
# - EMBEDDING_DRIVER=gemini: a native Gemini model id, e.g.
#   gemini-embedding-001 (same model, same 3072d-native/truncatable
#   behavior as above, just reached directly instead of via OpenRouter).
# - EMBEDDING_DRIVER=jina: a Jina embedding model id, e.g.
#   jina-embeddings-v3 (multilingual, truncatable via EMBEDDING_DIMENSION
#   through Jina's own `dimensions` request parameter).
# - EMBEDDING_DRIVER=vertex: a Vertex AI text embedding model id --
#   text-multilingual-embedding-002 for non-English content (confirmed
#   live, see docs/decisions.md's 2026-10-03 entry: text-embedding-005,
#   Vertex's *default* RAG embedding model, is only evaluated on English
#   text per Google's own docs and ranked a real Hungarian golden
#   question's correct document *below* several wrong ones -- the
#   multilingual model put it at rank #1 on the same query). Truncatable
#   via EMBEDDING_DIMENSION through this API's own `outputDimensionality`
#   parameter either way.

# Vector dimension of the selected model.
# intfloat/multilingual-e5-small        → 384
# paraphrase-multilingual-MiniLM-L12-v2 → 384
# text-embedding-3-small (OpenAI)        → 1536
# gemini-embedding-001 (OpenRouter or native gemini) → 3072 native, but both
#   OpenRouter's `dimensions` request parameter and the native API's
#   `output_dimensionality` config truncate it to whatever's set here --
#   confirmed empirically to work down to 384, matching this project's
#   default document_chunks schema with no migration needed.
EMBEDDING_DIMENSION=384

# API key for the embedding driver (only required when EMBEDDING_DRIVER is
# openai, openrouter, gemini, or jina -- NOT vertex, see below). For
# openrouter, this is the same OpenRouter API key as LLM_API_KEY below. For
# gemini, this is a *different kind* of key -- a native Google AI Studio
# key (aistudio.google.com/apikey), not an OpenRouter key. For jina, a Jina
# AI API key (jina.ai/?sui=apikey). Either way, set independently of
# LLM_API_KEY since embedding and answer generation are separate concerns
# even when they happen to share a provider account.
EMBEDDING_API_KEY=

# GCP project id and region (only required when EMBEDDING_DRIVER=vertex).
# No VERTEX_API_KEY exists -- Vertex AI authenticates via OAuth access
# tokens, not a static key; the driver shells out to the already-
# authenticated `gcloud auth print-access-token` instead.
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1

# Seconds to sleep before each embedding request (default: 0.0, no
# throttling). Meaningful for EMBEDDING_DRIVER=gemini or jina on a
# free-tier key, which has its own requests/tokens-per-minute limit --
# check your actual current limit on your provider's own quota page
# rather than assuming a number here, since free-tier limits change over
# time. Not needed for vertex (confirmed live: this project's default GCP
# quota handled a real bulk ingest with no throttling at all).
EMBEDDING_REQUEST_DELAY_SECONDS=0.0

# -----------------------------------------------------------------
# CHUNKING
# -----------------------------------------------------------------
# Approximate word count per text chunk (1 token ≈ 0.75 words English, ~0.5 Hungarian).
CHUNK_SIZE=250

# Word overlap between adjacent chunks (preserves context at boundaries).
CHUNK_OVERLAP=30

# Approximate words-per-token ratio, used to estimate whether CHUNK_SIZE
# likely exceeds the active embedding model's token limit. Only used by
# CHUNK_OVERFLOW_STRATEGY=warn. 0.75 is an English-average heuristic;
# morphologically rich languages (e.g. Hungarian) often tokenize worse —
# lower this if needed.
WORDS_PER_TOKEN=0.75

# What to do about chunks that likely/actually exceed the embedding model's
# token limit:
#   split (default)  — measure each chunk's REAL token count with the active
#                      driver's own tokenizer and re-split any chunk that
#                      overflows, so nothing is ever silently truncated.
#                      Requires a driver with a real tokenizer (currently
#                      only EMBEDDING_DRIVER=local) — falls back to warn
#                      otherwise.
#   warn             — estimate via WORDS_PER_TOKEN, log a warning, but still
#                      truncate silently at embed time.
CHUNK_OVERFLOW_STRATEGY=split

# Overlap ratio (0.0 to 0.5) between pieces when CHUNK_OVERFLOW_STRATEGY=split
# re-splits an oversized chunk. Preserves cross-boundary sentence context.
CHUNK_SPLIT_OVERLAP_RATIO=0.15

# How to extract text from a PDF before chunking. Only affects .pdf files —
# Markdown (.md/.markdown) is read as-is, it already has its own paragraph
# structure (blank lines, # headers), so there's nothing to detect.
#   flat   (default) — join each page's text with a single space. Fast, but
#                       paragraph structure is lost.
#   blocks            — additionally detect paragraph breaks from word
#                        coordinates and preserve them, so
#                        CHUNKING_STRATEGY=langchain can split on them.
#                        Can't detect a break that falls exactly at a page
#                        boundary (coordinates aren't comparable across
#                        pages) — a known, accepted limitation.
PDF_EXTRACTION_MODE=flat

# How to split the (whole-document, page-concatenated) text into chunks:
#   word      (default) — sliding word-count window (CHUNK_SIZE/CHUNK_OVERLAP
#                          above), same behavior as before, just applied to
#                          the whole document instead of per-page — this
#                          alone fixes a paragraph spanning a page break from
#                          being truncated into two chunks.
#   langchain            — paragraph-/sentence-aware splitting
#                          (langchain_text_splitters.RecursiveCharacterTextSplitter):
#                          tries to keep whole paragraphs/sentences together,
#                          only falling back to smaller units when a piece
#                          still doesn't fit the model's token limit.
CHUNKING_STRATEGY=word

# -----------------------------------------------------------------
# INGESTION
# -----------------------------------------------------------------
# Comma-separated list of file extensions permitted during batch directory
# ingestion. Only extensions registered in the code's
# EXTRACTOR_REGISTRY (.pdf, .md, .markdown, .docx, .rtf) are processed.
# Can be overridden at runtime via the allowed_extensions parameter.
INGEST_EXTENSIONS=.pdf,.md,.markdown,.docx,.rtf

# Whether add_document() generates a short, LLM-written, fact-focused
# summary per document (ingestion.summarize.generate_document_summary) and
# embeds it into every chunk -- costs one extra LLM_DRIVER call per document
# at ingest time. Set false to skip it (e.g. for a quick/cheap test ingest).
GENERATE_DOCUMENT_SUMMARY=true

# How many leading characters of a document's text to send to the LLM for
# summary generation.
DOCUMENT_SUMMARY_MAX_CHARS=6000

# -----------------------------------------------------------------
# LLM (answer generation)  — REQUIRED for query_knowledge_base
# -----------------------------------------------------------------
# Which LLM backend to use for answer generation.
# Options:
#   openrouter  - OpenRouter API; supports free models (default)
#   openai      - OpenAI Chat Completions API (paid subscription required)
#   gemini      - Google's native AI Studio API directly, not via OpenRouter
#                 (free-tier friendly; see LLM_REQUEST_DELAY_SECONDS below)
#   vertex      - the same Gemini models, served via Vertex AI instead of
#                 AI Studio -- added after AI Studio's free-tier quota kept
#                 being the throughput ceiling for a real eval run; billed
#                 against GCP credit instead, same VERTEX_PROJECT_ID/
#                 VERTEX_LOCATION as EMBEDDING_DRIVER=vertex, no LLM_API_KEY
#                 needed (authenticates via the already-logged-in gcloud
#                 CLI session instead, same as every other Vertex driver).
LLM_DRIVER=openrouter

# REQUIRED: API key for the active LLM driver, except for LLM_DRIVER=vertex.
#   OpenRouter key → https://openrouter.ai/keys
#   OpenAI key     → https://platform.openai.com/api-keys
#   Gemini key     → https://aistudio.google.com/apikey (a *different* kind
#                    of key than the OpenRouter one -- set independently of
#                    EMBEDDING_API_KEY too, even if both happen to use the
#                    same Gemini account)
LLM_API_KEY=your-llm-api-key-here

# Model identifier for the active LLM driver.
# Recommended: google/gemini-3.1-flash-lite (fast, cost-effective, pinned)
# for LLM_DRIVER=openrouter. Browse alternatives at https://openrouter.ai/models.
# For LLM_DRIVER=gemini or vertex, use a native model id instead, e.g.
# gemini-3.5-flash-lite -- check https://ai.google.dev/gemini-api/docs/models
# for current model ids and their free-tier daily request quotas, which vary
# a lot per model (confirmed empirically: a newer "thinking" model's free
# tier was capped at just 20 requests/day; LLM_DRIVER=vertex isn't subject
# to this AI-Studio-specific free-tier cap at all).
LLM_MODEL=google/gemini-3.1-flash-lite

# Seconds to sleep before each chat-completion request (default: 0.0, i.e.
# no throttling). Only meaningful for LLM_DRIVER=gemini on a free-tier API
# key, which has its own requests-per-minute limit -- check your own AI
# Studio quota page rather than assuming a number here, since free-tier
# limits change over time. Not needed for vertex (confirmed live: this
# project's default GCP quota handled 10 rapid, undelayed requests with no
# throttling at all).
LLM_REQUEST_DELAY_SECONDS=0.0

# How long one request to an LLM or embedding API may take before it is given up
# (seconds; applies to the SDK clients: Gemini, Vertex, OpenAI-compatible, and the
# embedding genai client). A timed-out request is retried like any transient
# failure (3 tries) and then raises. Without a limit a request that never gets an
# answer blocks forever (an eval run once sat idle for 21 minutes on one).
API_REQUEST_TIMEOUT_SECONDS=120

# Gemini's thinking-token budget (LLM_DRIVER=gemini/vertex only). Default 0
# disables thinking -- confirmed live on a "thinking" model (gemini-2.5-flash)
# that max_output_tokens is a *shared* budget across hidden reasoning and the
# visible answer: a real case spent 981 tokens thinking and left only 39 for
# the answer, truncating it mid-sentence with no citation at all. Set higher
# (or -1 for automatic) only if a future use case genuinely needs multi-step
# reasoning more than this grounded-answer task needs its full output budget.
LLM_THINKING_BUDGET=0

# -----------------------------------------------------------------
# RETRIEVAL
# -----------------------------------------------------------------
# Number of chunks to retrieve per query.
RETRIEVAL_TOP_K=4

# Minimum cosine similarity score (0–1). Chunks below this are discarded.
# Lower → more permissive. 0.25 is a sensible default for multilingual docs.
RETRIEVAL_MIN_SCORE=0.25

# Which retrieval path to use:
#   hybrid  (default) — vector + keyword (full-text) search, fused with
#                        Reciprocal Rank Fusion, then optionally reranked
#                        (see RERANKER_DRIVER below).
#   vector             — pure cosine-similarity search only, the
#                         pre-hybrid-search behavior. Mainly useful for
#                         comparison (scripts/evaluate_retrieval.py) —
#                         hybrid only adds recall over this at negligible
#                         extra cost, so there's little reason to prefer
#                         this day-to-day.
RETRIEVAL_STRATEGY=hybrid

# Candidate pool size for the vector + full-text searches feeding RRF
# fusion (and, if enabled, reranking) when RETRIEVAL_STRATEGY=hybrid —
# always at least RETRIEVAL_TOP_K, but wider by default so fusion/
# reranking has something to actually reorder.
RETRIEVAL_CANDIDATE_POOL_SIZE=20

# Hub-score computation (store.VectorStore.compute_hub_scores()): how many
# nearest neighbors (whole corpus, cosine similarity) to average per chunk
# for its hub_score -- a continuous "genericness" measure used to re-rank
# dense retrieval results (query.retrieval._csls_rerank), never to exclude a
# chunk outright. Supersedes a rejected, harder approach (a fixed-threshold
# "boilerplate" exclusion flag that over-flagged 40% of a real corpus,
# including a known-correct answer's own chunks -- see docs/decisions.md).
HUB_SCORE_NEIGHBOR_SAMPLE_SIZE=20

# Final listwise LLM disambiguation pass (query.listwise_rerank), right
# before the top_k cut: reads every remaining candidate document's
# document_summary side by side and picks the one that actually answers the
# question, explicitly ignoring shared/formulaic framing a per-pair
# cross-encoder can't see past. Costs one extra LLM_DRIVER call per query,
# so it's opt-in.
LISTWISE_RERANK_ENABLED=false
LISTWISE_RERANK_MAX_CANDIDATES=20

# Spread exact-identifier matches (case numbers, ...) across the distinct
# documents a question names, instead of letting one long document take
# every guaranteed top_k slot. true/false; on by default after an A/B
# measurement (uv run python corpus/cli.py compare-retrieval).
RETRIEVAL_DIVERSIFY_GUARANTEES=true

# Widen the candidate pool with documents from the years the question names
# ("... 2020 és 2022 között"): embeddings are weak at telling years apart.
# Reads each document's document_date; soft (adds candidates, never removes
# any). true/false; off until A/B-measured (corpus/cli.py compare-retrieval).
RETRIEVAL_PERIOD_FILTER=false

# Tell the answer LLM to refuse only when NO excerpt is relevant, and otherwise
# to answer with what the excerpts show and say what they do not cover (the
# strict wording refused broad questions with partial context every time).
# true/false. Its regression check passed (adversarial still declined, single-
# document questions unchanged; docs/decisions.md, 2026-10-05), but it stays off
# while the system is developed so runs can be compared; the plan is to make it
# the only behaviour (and delete this switch) once the full end-of-work run confirms it.
ANSWER_PARTIAL_COVERAGE=false

# Route each question first: counting/listing/summing questions ("how many ...
# last October") are answered exactly from the structured metadata, content
# questions run the normal retrieval inside the documents the planner's filters
# select, and a question naming a case/document identifier skips the planner.
# Needs the metadata catalog + extracted values (docs/structured-metadata-design.md).
# true/false; off until the planner has been measured (`meta-plan-eval`).
QUERY_ROUTER=false

# Which document type's key catalog the router plans over (the doc type given to
# `meta_cli.py load-catalog`). Required when QUERY_ROUTER=true; the core names none.
QUERY_ROUTER_DOC_TYPE=

# Show each excerpt's document_date to the answer LLM (excerpt header) so a
# question's date range can actually be checked. true/false; off until
# A/B-measured.
EXPOSE_DOCUMENT_DATE=false

# Second retrieval stage: reorders the hybrid-search candidate pool with a
# cross-encoder that scores (question, chunk) pairs jointly — more accurate
# than embedding similarity alone, and the second, embedding-model-
# independent relevance gate (see RERANKER_MIN_SCORE below). This is
# necessary in practice, not just a quality lever: confirmed empirically
# that switching EMBEDDING_DRIVER can shift the raw vector-similarity scale
# enough that RETRIEVAL_MIN_SCORE alone no longer tells relevant from
# irrelevant queries apart, while the reranker still did. Adds real latency
# and a model download. Only applies when RETRIEVAL_STRATEGY=hybrid.
#   cross_encoder (default) — rerank with RERANKER_MODEL below (local,
#                              free, offline — same download-on-first-use
#                              pattern as EMBEDDING_DRIVER=local).
#   jina                     — rerank via Jina AI's hosted Reranker API
#                              instead of the local cross-encoder, to
#                              offload the CPU-bound reranking cost
#                              confirmed live at ~6s/question steady-state.
#   vertex                   — rerank via Google Cloud's standalone
#                              Discovery Engine Ranking API instead --
#                              added after Jina's free-tier
#                              tokens-per-minute cap interrupted a real
#                              eval run; billed against GCP credit, same
#                              VERTEX_PROJECT_ID as EMBEDDING_DRIVER=vertex.
#   none                     — skip reranking, use the RRF-fused order
#                              as-is. Kept for comparison/eval only
#                              (make eval vs. make eval-rerank) — not
#                              recommended for production.
RERANKER_DRIVER=cross_encoder

# Model id for the active reranker driver.
# - RERANKER_DRIVER=cross_encoder: a Sentence-Transformers CrossEncoder
#   model. Multilingual (MMARCO: MS MARCO machine-translated into 14
#   languages) — chosen over the more common English-only
#   cross-encoder/ms-marco-MiniLM-L-6-v2 to match this project's Hungarian +
#   English content, same reasoning as EMBEDDING_MODEL above.
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
# - RERANKER_DRIVER=jina: a Jina reranker model id, e.g.
#   jina-reranker-v2-base-multilingual.
# - RERANKER_DRIVER=vertex: a Vertex ranking model id, e.g.
#   semantic-ranker-default@latest.

# API key for the reranker driver (only required when RERANKER_DRIVER=jina
# -- NOT vertex, which authenticates via the already-logged-in gcloud CLI
# session instead, same as EMBEDDING_DRIVER=vertex, no separate key).
# A Jina AI API key (jina.ai/?sui=apikey) -- can be the same key as
# EMBEDDING_API_KEY when EMBEDDING_DRIVER=jina too, but configured
# independently since reranking and embedding are separate concerns.
RERANKER_API_KEY=

# Minimum logit relevance score required from the cross-encoder.
# Calibrated to -2.0 to allow longer or multi-topic chunks (> -2.0) while
# cleanly rejecting out-of-domain or unanswerable queries (< -3.5).
# Candidates scoring below this are dropped. If no candidate clears this threshold,
# the query is rejected early as having no relevant answer.
RERANKER_MIN_SCORE=-2.0

# -----------------------------------------------------------------
# DATABASE  — REQUIRED
# -----------------------------------------------------------------
# PostgreSQL connection URL with pgvector extension enabled.
#
# Quick start (recommended, no account needed): run `make setup` (or
# `docker compose up -d --wait`), which starts a local Postgres+pgvector
# via docker-compose.yml and creates the "docs_agent" database — the
# value below matches it out of the box.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_agent

# Alternative: any managed Postgres with pgvector works too (e.g. Supabase).
#   Obtain from: Supabase Dashboard → Project Settings → Database → Connection string
#   Use the "Session Mode" pooler URL (port 5432 or 6543).
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# How many candidates the HNSW vector index explores per query, set via
# `SET hnsw.ef_search = ...` on every connection (default here: 400;
# pgvector's own default is 40). Confirmed live: at pgvector's default,
# a vector query silently returned far fewer rows than its SQL LIMIT asked
# for once the corpus grew into the tens of thousands of chunks -- the
# index itself was the bottleneck, not RETRIEVAL_TOP_K/
# RETRIEVAL_CANDIDATE_POOL_SIZE downstream of it. Higher values trade
# query latency for recall.
HNSW_EF_SEARCH=400

# -----------------------------------------------------------------
# OBSERVABILITY / LOGGING
# -----------------------------------------------------------------
# Path to the structured JSONL audit/events log file.
# Useful for monitoring retrieval steps, stop-word filtering, and reranking.
LOG_FILE=logs/log.jsonl

# -----------------------------------------------------------------
# DEVELOPMENT / TESTING
# -----------------------------------------------------------------
# Path to a document (PDF or Markdown — format detected from the
# extension) used by scripts/extract_text.py, scripts/inspect_chunks.py,
# and the tests/db/ add_document() end-to-end test. Point this at any PDF
# or .md file on your machine. No PDF is checked into the repo for this —
# a real-world PDF is usually someone's actual document, so ⚠️ never commit
# whatever you point this at, keep it in .env only. tests/data/sample.md
# is a safe, hand-written Markdown fixture if you just want something that
# works out of the box.
TEST_DOC_PATH=tests/data/sample.md

# tests/db/ (real INSERT/DELETE/TRUNCATE, and migration tests even
# CREATE/DROP TABLE) is enabled by AGENT_ENV=test — `make test` sets this
# automatically. It requires a .env.test file (see .env.test.example) with
# its own DATABASE_URL, loaded on top of this file — never reuses the
# DATABASE_URL above. AGENT_ENV itself must never be set in .env/.env.test
# (see config.py for why); it's always a real shell/CI env var.
