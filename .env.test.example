# Test environment overrides — loaded ON TOP OF .env when AGENT_ENV=test
# (see config.py). Only needs to contain keys that differ from .env; every
# other setting (LLM_API_KEY, EMBEDDING_DRIVER, ...) is inherited unchanged.
#
# Copy this file to .env.test to enable tests/db/ (skipped without it).
#
# MUST be a separate database from .env's DATABASE_URL — tests/db/ runs
# real INSERT/DELETE/TRUNCATE, and migration tests even CREATE/DROP TABLE.
# The local docker-compose Postgres creates "docs_agent_test" automatically
# (see docker/init-test-db.sql) — the value below matches it out of the box.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docs_agent_test
